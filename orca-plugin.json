{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "agent-keypad",
  "name": "Agent Keypad for Orca",
  "version": "0.4.0",
  "description": "See at a glance which Orca agent needs you. Each agent chat or pane gets a key on the Logi MX Creative Keypad that shows its state and opens it when pressed.",
  "icon": "orca-plugin/images/icon.png",
  "cover": {
    "path": "orca-plugin/images/cover.png",
    "alt": "An MX Creative Keypad drawn with Orca agent chats on its keys: working (blue), needs you (yellow), done (green), plus the Status and Attention keys"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "main": "orca-plugin/main.mjs",
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:write"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "deck.map",
        "title": "Agent Keypad: Open panel",
        "when": "global"
      },
      {
        "id": "deck.status",
        "title": "Agent Keypad: Show status",
        "when": "global"
      },
      {
        "id": "deck.record",
        "title": "Agent Keypad: Record events",
        "when": "global"
      },
      {
        "id": "deck.uninstall",
        "title": "Agent Keypad: Uninstall",
        "when": "global"
      }
    ],
    "panels": [
      {
        "id": "deck",
        "title": "Agent Keypad",
        "icon": "agent",
        "entry": "orca-plugin/panel.jsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "deck",
        "icon": "link",
        "text": "Agent Keypad",
        "tooltip": "Open Agent Keypad: the panel to map Orca panes and agent chats to keypad keys",
        "command": "deck.map"
      }
    ],
    "keybindings": [
      {
        "command": "deck.map",
        "key": "Mod+Alt+K"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  }
}
