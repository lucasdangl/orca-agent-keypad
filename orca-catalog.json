          "minimumOrca": "1.4.248",
          "name": "Agent Keypad for Orca",
          "contributes": [
            {
              "kind": "panels",
              "name": "Agent Keypad"
            },
            {
              "kind": "commands",
              "name": "Agent Keypad: Open panel"
            },
            {
              "kind": "commands",
              "name": "Agent Keypad: Show status"
            },
            {
              "kind": "commands",
              "name": "Agent Keypad: Record events"
            },
            {
              "kind": "commands",
              "name": "Agent Keypad: Uninstall"
            },
            {
              "kind": "events",
              "name": "agent.status.changed"
